{
  "name": "stackd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STACKD \u2014 website, mobile apps, and loyalty program",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "pg": "^8.13.1"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --test \"functions/*.test.js\" && node --test \"supabase/*.test.mjs\"",
    "test:db": "node --test \"supabase/*.test.mjs\"",
    "db:reset": "node scripts/db-reset.mjs",
    "sync:menu": "node scripts/sync-menu.mjs",
    "dev": "npm run dev --workspace @stackd/web",
    "build": "npm run build --workspace @stackd/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run build && node scripts/preview.mjs",
    "deploy": "npm run build && npx wrangler pages deploy apps/web/out --project-name=stackd --branch=master",
    "deploy:preview": "npm run build && npx wrangler pages deploy apps/web/out --project-name=stackd --branch=preview"
  }
}
