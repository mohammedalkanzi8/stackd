# Copy to deploy/.env on the server and fill in. Never commit the filled copy —
# .gitignore already excludes it.
#
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env
#
# Generate each secret with:  openssl rand -hex 32

# --- Database ----------------------------------------------------------------
# Read ONLY on the very first start, when the data volume is empty. Changing it
# later does not change the password Postgres already stored — you have to ALTER
# ROLE inside the container, or destroy the volume and restore from a backup.
POSTGRES_PASSWORD=
POSTGRES_USER=stackd
STACKD_DB=stackd

# --- Session signing ---------------------------------------------------------
# Different values. Both apps refuse to sign a session in production without
# one, rather than falling back to a default that would make cookies forgeable.
# Changing either signs everyone out of that portal, which is the emergency
# lever if a cookie ever leaks.
STACKD_PORTAL_SECRET=
STACKD_ADMIN_SECRET=

# --- Public addresses --------------------------------------------------------
# STACKD_PORTAL_URL is read at RUNTIME and is what every printed QR encodes —
# the bill claim codes and the counter signup poster. Wrong here means reprinting.
STACKD_PORTAL_URL=https://my.stackd.com.sa

# Hostnames Caddy gets certificates for. They must already resolve to this
# server or the Let's Encrypt challenge fails.
PORTAL_DOMAIN=my.stackd.com.sa
ADMIN_DOMAIN=admin.stackd.com.sa
TLS_EMAIL=info@stackd.com.sa

# --- Admin access ------------------------------------------------------------
# Source addresses allowed to reach the staff portal. Defaults to the whole
# internet so the first deploy is not a lockout — NARROW IT. The shop's public
# IP, or a VPN range. Space-separated CIDRs.
#   ADMIN_ALLOW_CIDR=203.0.113.4/32 198.51.100.0/24
ADMIN_ALLOW_CIDR=0.0.0.0/0

# --- Website build -----------------------------------------------------------
# NOT used by the stack. It is compiled into the STATIC SITE at build time, so
# it belongs wherever `npm run build` runs for apps/web — set it there before
# building, or the "My points" link in the header points at localhost.
#   NEXT_PUBLIC_PORTAL_URL=https://my.stackd.com.sa

# --- Wallet passes (all optional) --------------------------------------------
# Both buttons stay hidden until their block is filled in. Neither is required.
# Full setup, including the gotchas: docs/deploy/WALLET.md
#
# PEM values must keep their \n escapes on a single line — an env file cannot
# hold real newlines. The wrong form fails with a DECODER error that says
# nothing about newlines.

# Google Wallet. Free, but a new issuer account starts in DEMO MODE: only
# accounts you list as testers can save a pass until publishing access is
# granted, and everyone else just sees it fail.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLIENT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
# GOOGLE_WALLET_ORIGINS=https://my.stackd.com.sa

# Apple Wallet. Needs an Apple Developer membership at US$99/year — there is no
# unsigned path. The certificate expires annually and passes stop signing.
# APPLE_WALLET_PASS_TYPE_ID=pass.com.sa.stackd.rewards
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_CERT_PEM=
# APPLE_WALLET_KEY_PEM=
# APPLE_WALLET_WWDR_PEM=
