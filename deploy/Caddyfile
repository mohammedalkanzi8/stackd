# TLS and routing for the STACKD stack.
#
# Caddy gets certificates from Let's Encrypt automatically and renews them, so
# there is no cron job and no expiry to forget. It needs ports 80 and 443 open
# and the DNS record already pointing here — the HTTP-01 challenge fails
# otherwise, and the failure looks like a certificate problem rather than a DNS one.

{
	email {$TLS_EMAIL}
}

# --- Customer portal: my.stackd.com.sa ---------------------------------------
#
# ⚠ This hostname must be DNS-ONLY at Cloudflare (grey cloud, not orange).
# Proxying it would terminate TLS at Cloudflare's edge, which puts customer
# names, phone numbers and order history through a US company's network — the
# cross-border transfer that PDPL governs and that SDAIA has published no
# adequacy list for. Proxy the static marketing site all you like; not this.
{$PORTAL_DOMAIN} {
	encode zstd gzip

	# Next fingerprints these filenames, so they can be cached hard.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# There was NO CSP on either host. Nothing contained an XSS if one ever
		# landed — including the JSON-LD sink on the website, which puts
		# JSON.stringify output into a <script> without escaping `<`.
		#
		# 'unsafe-inline' for style- and script-src is required by Next: it
		# inlines the RSC flight payload and hydration bootstrap as inline
		# <script>, and styled-jsx emits inline <style>. Dropping it breaks the
		# app, so this is deliberately a containment boundary rather than a
		# complete one — it still stops external script loads, framing, form
		# hijacking and plugin embedding, which is most of what an injected
		# payload wants.
		#
		# ⚠ `img-src data: blob:` is needed: the member QR is an inline SVG and
		# the wallet buttons are data URIs.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		# The scanner asks for the camera; nothing else here needs any of these.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	reverse_proxy portal:3002
}

# --- Staff portal: admin.stackd.com.sa ---------------------------------------
#
# Restricted by source address. Set ADMIN_ALLOW_CIDR to the shop's public range,
# or put Cloudflare Access / a VPN in front and leave this open. It defaults to
# open so a first deploy is not a lockout, which means TIGHTENING IT IS A REAL
# STEP, not an optional one. Change it with `deploy/admin-allow.sh`, which
# checks the new list against the address you are connected from first.
#
# ⚠ This hostname must also stay DNS-ONLY at Cloudflare, for a second reason:
# an orange cloud makes every request arrive from a Cloudflare edge address, so
# the allowlist below would be matching the proxy instead of the visitor — it
# would admit the whole internet or nobody, and look like a Caddy bug either way.
{$ADMIN_DOMAIN} {
	encode zstd gzip

	# The 403 names the address it rejected. Being locked out is the one moment
	# you cannot look this up from the inside, and a bare "denied" leaves you
	# guessing at exactly the value you need to type.
	#
	# A private address here (172.x / 10.x) means Caddy is reading Docker's
	# bridge rather than the real client, and no allowlist can work until that
	# is fixed. See docs/deploy/SERVER.md § "The staff portal allowlist".
	@blocked not remote_ip {$ADMIN_ALLOW_CIDR}
	respond @blocked `Not available from this network.

Your address: {http.request.remote.host}

To allow it, on the server:  deploy/admin-allow.sh add {http.request.remote.host}
` 403

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# ⚠ Was missing here while the portal had it: without it, a staff member
		# following a link out of the portal leaks the admin URL they came from.
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		# Belt and braces with the noindex in metadata: a staff portal must never
		# appear in a search result.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy admin:3001
}
