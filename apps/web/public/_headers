# Cloudflare Pages headers. Replaces the Apache <IfModule> blocks from the
# previous .htaccess (kept at docs/deploy/htaccess-apache.txt in case the site
# ever moves back to Apache hosting).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # HSTS is deliberately omitted until HTTPS is confirmed working on
  # stackd.com.sa. Cloudflare issues the certificate automatically, but a
  # misconfigured cert with HSTS enabled locks visitors out for a year.
  # Add once verified:
  #   Strict-Transport-Security: max-age=31536000; includeSubDomains

# Next fingerprints these filenames, so the content can never change under a
# given URL. Safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and brand artwork change rarely and are not fingerprinted, so they get a
# long but not infinite life.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=2592000

# HTML must stay short-lived or a menu or price change will not reach people who
# have already visited.
/*.html
  Cache-Control: public, max-age=600, must-revalidate
